# SPDX-License-Identifier: GPL-2.0-only
# Experimental fogos 6.1 bring-up. Preserve the existing firmware target.
CONFIG_FOGOS_DTB=y
CONFIG_BANGKK_DTB=y
CONFIG_FOGOS_LEGACY_AUDIO=y
# CONFIG_MALMO_DTB is not set
# CONFIG_PINCTRL_MALMO is not set
# CONFIG_BATT_THERMAL_100K_MALMO is not set
# Avoid compiling the upstream SoundWire core beside the retained vendor core.
# CONFIG_SOUNDWIRE is not set
CONFIG_LOCALVERSION="-android14-0-sedona"
# Development builds do not enforce the donor's unrelated module symbol list.
# CONFIG_TRIM_UNUSED_KSYMS is not set

# Keep development module vermagic stable across Git checkpoints.
# CONFIG_LOCALVERSION_AUTO is not set
